{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "locales-response.schema.json",
  "title": "LocalesResponse",
  "type": "object",
  "additionalProperties": false,
  "required": ["locales"],
  "properties": {
    "locales": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tag", "code", "name", "selfName", "direction", "default",
          "schemaVersion", "version", "properNamePolicy"
        ],
        "properties": {
          "tag": { "type": "string" },
          "code": { "type": "string" },
          "name": { "type": "string", "minLength": 1 },
          "selfName": { "type": "string", "minLength": 1 },
          "direction": { "type": "string", "enum": ["ltr", "rtl"] },
          "default": { "type": "boolean" },
          "schemaVersion": { "type": "integer", "const": 1 },
          "version": { "type": "string" },
          "properNamePolicy": {
            "type": "string",
            "enum": ["localized", "english-retained"]
          }
        }
      }
    }
  }
}
