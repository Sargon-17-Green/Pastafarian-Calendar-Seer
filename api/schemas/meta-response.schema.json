{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "meta-response.schema.json",
  "title": "MetaResponse",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "apiVersion",
    "presentations",
    "includes",
    "observerPresets",
    "reverse",
    "packageVersion",
    "releaseTag",
    "commit",
    "artifactMode",
    "engineFingerprint",
    "supportedFeatures",
    "cacheRevision"
  ],
  "properties": {
    "apiVersion": {
      "const": "v1"
    },
    "presentations": {
      "type": "array",
      "items": {
        "enum": [
          "full",
          "canonical"
        ]
      }
    },
    "includes": {
      "type": "array",
      "items": {
        "enum": [
          "structure",
          "boundaries",
          "provenance",
          "resolution"
        ]
      }
    },
    "observerPresets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "longitude"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "longitude": {
            "type": "number"
          }
        }
      }
    },
    "reverse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "endpoint",
        "requiresCompleteTuple"
      ],
      "properties": {
        "status": {
          "const": "implemented"
        },
        "endpoint": {
          "const": "/v1/reverse"
        },
        "requiresCompleteTuple": {
          "const": true
        }
      }
    },
    "exactDomain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "minimumJdnExclusive",
        "maximumJdnInclusive"
      ],
      "properties": {
        "kind": {
          "const": "finite"
        },
        "minimumJdnExclusive": {
          "const": "-63473948"
        },
        "maximumJdnInclusive": {
          "const": "36828783"
        }
      }
    },
    "packageVersion": {
      "type": "string",
      "minLength": 1
    },
    "releaseTag": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^v[0-9A-Za-z][0-9A-Za-z.+-]*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "commit": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "artifactMode": {
      "enum": [
        "source",
        "package",
        "container"
      ]
    },
    "engineFingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "supportedFeatures": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "now-query",
          "date-query",
          "batch-query",
          "range-query",
          "range-ndjson",
          "range-csv",
          "year-query",
          "reverse-query",
          "calculation-day",
          "locales",
          "canonical-presentation",
          "full-presentation",
          "public-status",
          "openapi"
        ]
      }
    },
    "cacheRevision": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
