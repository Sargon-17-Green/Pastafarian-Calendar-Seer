{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "calculation-day-response.schema.json",
  "title": "CalculationDayResponse",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "at",
    "jdn",
    "observer"
  ],
  "properties": {
    "at": {
      "type": "string",
      "format": "date-time"
    },
    "jdn": {
      "$ref": "./exact-integer-string.schema.json"
    },
    "observer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "longitude"
      ],
      "properties": {
        "longitude": {
          "type": "number",
          "minimum": -180,
          "exclusiveMaximum": 180
        }
      }
    },
    "boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "startsAt",
        "endsAt"
      ],
      "properties": {
        "startsAt": {
          "type": "string",
          "format": "date-time"
        },
        "endsAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
