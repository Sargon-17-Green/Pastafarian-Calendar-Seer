{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seer.pastafarian.example/schemas/positive-exact-integer.schema.json",
  "title": "PositiveExactIntegerInput",
  "oneOf": [
    {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    {
      "type": "string",
      "pattern": "^[1-9][0-9]*$"
    }
  ]
}
