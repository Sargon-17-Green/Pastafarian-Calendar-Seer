{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seer.pastafarian.example/schemas/gregorian-date-output.schema.json",
  "title": "GregorianDateOutput",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "era",
    "year",
    "month",
    "day"
  ],
  "properties": {
    "era": {
      "type": "string",
      "enum": [
        "BCE",
        "CE"
      ]
    },
    "year": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$"
    },
    "month": {
      "type": "integer",
      "minimum": 1,
      "maximum": 12
    },
    "day": {
      "type": "integer",
      "minimum": 1,
      "maximum": 31
    }
  }
}
