{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seer.pastafarian.example/schemas/gregorian-date.schema.json",
  "title": "GregorianDateInput",
  "description": "Proleptic Gregorian civil date. Short form is CE only; structured form is used for BCE and arbitrarily large years.",
  "oneOf": [
    {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "era",
        "year",
        "month",
        "day"
      ],
      "properties": {
        "era": {
          "type": "string",
          "enum": [
            "BCE",
            "CE"
          ]
        },
        "year": {
          "$ref": "./positive-exact-integer.schema.json"
        },
        "month": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "day": {
          "type": "integer",
          "minimum": 1,
          "maximum": 31
        }
      }
    }
  ]
}
