{
  "name": "pastafarian-calendar-seer",
  "version": "0.1.0",
  "description": "Exact high-performance query and HTTP runtime for the Pastafarian Calendar Seer",
  "type": "module",
  "main": "./index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./query": "./query/index.mjs",
    "./client": "./client/index.mjs",
    "./http": "./http/index.mjs",
    "./http/server": "./http/server.mjs",
    "./openapi.json": "./api/openapi.json",
    "./openapi.yaml": "./api/openapi.yaml",
    "./schemas/*": "./api/schemas/*",
    "./package.json": "./package.json"
  },
  "bin": {
    "pastafarian-seer": "./query/cli.mjs",
    "pastafarian-seer-http": "./http/server.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "index.mjs",
    "query/*.mjs",
    "query/locales/*.mjs",
    "client/*.mjs",
    "http/*.mjs",
    "api/openapi.json",
    "api/openapi.yaml",
    "api/schemas/*.json",
    "precompute/cache-lookup.mjs",
    "precompute/validate-generated.mjs",
    "precompute/lib/cache-format.mjs",
    "precompute/lib/schedule.mjs",
    "precompute/vendor/pastafari-calendar-1.4.1/venus-day-boundary.js",
    "generated/index.json",
    "generated/calc/*.json",
    "prototype/src/pastafarian_year_batch.cpp",
    "prototype/src/rns_micro8_avx2_32x8.cpp",
    "prototype/src/rns_micro8_portable.cpp",
    "prototype/src/rns_primes.hpp",
    "prototype/src/rns_primes32.hpp",
    "prototype/src/sauce_fast127_v12.hpp",
    "prototype/src/seer_engine_service.cpp",
    "prototype/src/seer_year_locator.cpp",
    "prototype/src/seer_year_structure.cpp",
    "prototype/src/year_fast_bench_v12.cpp",
    "prototype/data/gates_u16.bin",
    "prototype/data/gates_negative_u16.bin",
    "prototype/scripts/build_year_batch.sh",
    "prototype/scripts/build_year_locator.sh",
    "prototype/scripts/build_year_structure.sh",
    "prototype/scripts/build_engine_service.sh",
    "scripts/package-selftest.mjs",
    "scripts/build-runtime.mjs",
    "scripts/build-runtime.ps1",
    "scripts/build-runtime.sh",
    "docs/DEPLOYMENT_STAGE6.md",
    "README_STAGE6.md",
    "README.md",
    "LICENSE",
    "NOTICE.md"
  ],
  "scripts": {
    "build:native": "node ./scripts/build-runtime.mjs",
    "start": "node ./http/server.mjs",
    "cli": "node ./query/cli.mjs",
    "test": "node ./scripts/package-selftest.mjs",
    "validate:cache": "node ./precompute/validate-generated.mjs",
    "test:repo": "node --test precompute/test/*.test.mjs query/test/*.test.mjs client/test/*.test.mjs http/test/*.test.mjs deployment/test/*.test.mjs"
  },
  "keywords": [
    "pastafarian",
    "calendar",
    "http",
    "api"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sargon-17-Green/Pastafarian-Calendar-Seer.git"
  },
  "bugs": {
    "url": "https://github.com/Sargon-17-Green/Pastafarian-Calendar-Seer/issues"
  },
  "homepage": "https://github.com/Sargon-17-Green/Pastafarian-Calendar-Seer#readme"
}
